###############################################################################
# G3_neg.sub — HTCondor submit for GMT-overlap dataset G3_neg
# single displaced muon, OMTF overlap, no PU, negative eta [-1.24,-0.82]
# Target: 125000 events, 500 events/job, 250 jobs
###############################################################################
universe        = vanilla
executable      = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/run_job.sh
arguments       = G3_neg $(ProcId) 0 500

output          = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/G3_neg_$(ProcId).out
error           = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/G3_neg_$(ProcId).err
log             = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/G3_neg.log

should_transfer_files = NO

request_cpus    = 1
request_memory  = 4000
request_disk    = 5000000

+JobFlavour     = "workday"

+AccountingGroup = "group_u_CMS.u_zh.users"
use_x509userproxy = true
x509userproxy    = /afs/cern.ch/user/p/pleguina/private/x509_proxy

queue 250
