###############################################################################
# C28_mild_disp_pt5to10_overlap_PU200.sub — HTCondor submit for controlled overlap study dataset C28_mild_disp_pt5to10_overlap_PU200
# Mild-displaced pT 5-10 GeV overlap PU200 — WP4/WP5 ambiguity zone
# Target: 200000 events, 500 events/job, 400 jobs
###############################################################################
universe        = vanilla
executable      = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/run_job.sh


should_transfer_files = NO

request_cpus    = 1
request_memory  = 4000
request_disk    = 5000000

+JobFlavour     = "workday"

+AccountingGroup = "group_u_CMS.u_zh.users"
use_x509userproxy = true
x509userproxy    = /afs/cern.ch/user/p/pleguina/private/x509_proxy


arguments = C28_mild_disp_pt5to10_overlap_PU200 288 0 500
output    = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/C28_mild_disp_pt5to10_overlap_PU200_288.out
error     = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/C28_mild_disp_pt5to10_overlap_PU200_288.err
log       = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/C28_mild_disp_pt5to10_overlap_PU200.log
queue

arguments = C28_mild_disp_pt5to10_overlap_PU200 384 0 500
output    = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/C28_mild_disp_pt5to10_overlap_PU200_384.out
error     = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/C28_mild_disp_pt5to10_overlap_PU200_384.err
log       = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/C28_mild_disp_pt5to10_overlap_PU200.log
queue

