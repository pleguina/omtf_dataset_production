###############################################################################
# smoke_prodv3_cclut.sub
# prodv3 smoke, CSC CCLUT on the TMBs (OMTF_CSC_CCLUT_TMB=1): CSC slope variant, not a baseline.
# CMSSW_20_0_0_patch2 + new OMTF, D127 + Phase2Fall26GS pileup, written to EOS prodv3_smoke/ (not prodv3/).
###############################################################################
universe        = vanilla
executable      = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/run_job_prodv3.sh
arguments       = $(Dataset) $(JobId) 0 50
environment     = "OMTF_EOS_BASE=/eos/user/p/pleguina/omtf_hecin_datasets/prodv3_smoke_cclut OMTF_CAMPAIGN_ID=3002 OMTF_CSC_CCLUT_TMB=1"

output          = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/smoke_prodv3_cclut_$(Dataset)_$(JobId).out
error           = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/smoke_prodv3_cclut_$(Dataset)_$(JobId).err
log             = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/smoke_prodv3_cclut.log

should_transfer_files = NO

request_cpus    = 1
request_memory  = 6000
request_disk    = 15000000

+JobFlavour     = "workday"
+AccountingGroup = "group_u_CMS.u_zh.users"
use_x509userproxy = true
x509userproxy    = /afs/cern.ch/user/p/pleguina/private/x509_proxy

queue Dataset, JobId from (
C10_disp_pt20to50_overlap, 0
C10_disp_pt20to50_overlap, 1
C4_prompt_pt20to50_overlap, 0
)
