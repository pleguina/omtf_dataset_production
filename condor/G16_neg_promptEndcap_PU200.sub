###############################################################################
# G16_neg_promptEndcap_PU200.sub — HTCondor submit for dataset G16_neg_promptEndcap_PU200
# Prompt muon, eta -2.4 to -1.6 endcap control, PU200
# Target: 100000 events, 500 events/job, 200 jobs
###############################################################################
universe        = vanilla
executable      = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/run_job.sh
arguments       = G16_neg_promptEndcap_PU200 $(ProcId) 0 500

output          = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/G16_neg_promptEndcap_PU200_$(ProcId).out
error           = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/G16_neg_promptEndcap_PU200_$(ProcId).err
log             = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/G16_neg_promptEndcap_PU200.log

should_transfer_files = NO

request_cpus    = 1
request_memory  = 4000
request_disk    = 5000000

+JobFlavour     = "workday"

+AccountingGroup = "group_u_CMS.u_zh.users"
use_x509userproxy = true
x509userproxy    = /afs/cern.ch/user/p/pleguina/private/x509_proxy

queue 200
