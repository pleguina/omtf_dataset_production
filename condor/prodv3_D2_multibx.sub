###############################################################################
# prodv3_D2_multibx.sub  --  runbook prodv3 extra samples (D2 LLP with the OMTF BX window [-1,1]; NanoAOD omtf*/gmt* tables mix BXs, use OMTFHitsTree.omtfBx)
# CMSSW_20_0_0_patch2 + pleguina:wp8-dumper, D127 + Phase2Fall26GS pileup, EOS prodv3/.
# Job lists: prodv3_D2_multibx.txt (Dataset, JobId, NEvents).
###############################################################################
universe        = vanilla
executable      = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/run_job_prodv3.sh
arguments       = $(Dataset) $(JobId) 0 $(NEvents)
environment     = "OMTF_CAMPAIGN_ID=3101 OMTF_BX_RANGE=-1,1 OMTF_EOS_BASE=/eos/user/p/pleguina/omtf_hecin_datasets/prodv3_multibx"

output          = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/prodv3/$(Dataset)_$(JobId).out
error           = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/prodv3/$(Dataset)_$(JobId).err
log             = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/prodv3/prodv3_D2_multibx.log

should_transfer_files = NO

request_cpus    = 1
request_memory  = 6000
request_disk    = 15000000

+JobFlavour     = "tomorrow"
+AccountingGroup = "group_u_CMS.u_zh.users"
use_x509userproxy = true
x509userproxy    = /afs/cern.ch/user/p/pleguina/private/x509_proxy

queue Dataset, JobId, NEvents from prodv3_D2_multibx.txt
