###############################################################################
# G5.sub — HTCondor submit for GMT-overlap dataset G5
# G5_twoDisplacedOverlap_PU200: two displaced muons, OMTF overlap, PU200
# Target: 200,000 events, 500 events/job, 400 jobs
###############################################################################
universe        = vanilla
executable      = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/run_job.sh
arguments       = G5 $(ProcId) 0 500

output          = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/G5_$(ProcId).out
error           = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/G5_$(ProcId).err
log             = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/G5.log

should_transfer_files = NO

request_cpus    = 1
request_memory  = 4000
request_disk    = 5000000

+JobFlavour     = "tomorrow"

+AccountingGroup = "group_u_CMS.u_zh.users"
use_x509userproxy = true
x509userproxy    = /afs/cern.ch/user/p/pleguina/private/x509_proxy

queue 400
