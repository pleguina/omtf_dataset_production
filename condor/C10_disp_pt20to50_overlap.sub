###############################################################################
# C10_disp_pt20to50_overlap.sub — HTCondor submit for C-campaign low-pT/no-PU completion
# Displaced pT 20-50 GeV overlap, no PU
# Target: 150000 events, 500 events/job, 300 jobs
###############################################################################
universe        = vanilla
executable      = /afs/cern.ch/user/p/pleguina/omtf_hecin_dataset_production/condor/run_job.sh
arguments       = C10_disp_pt20to50_overlap $(ProcId) 0 500

output          = /afs/cern.ch/user/p/pleguina/omtf_hecin_dataset_production/condor/logs/C10_disp_pt20to50_overlap_$(ProcId).out
error           = /afs/cern.ch/user/p/pleguina/omtf_hecin_dataset_production/condor/logs/C10_disp_pt20to50_overlap_$(ProcId).err
log             = /afs/cern.ch/user/p/pleguina/omtf_hecin_dataset_production/condor/logs/C10_disp_pt20to50_overlap.log

should_transfer_files = NO

request_cpus    = 1
request_memory  = 4000
request_disk    = 5000000

+JobFlavour     = "workday"

+AccountingGroup = "group_u_CMS.u_zh.users"
use_x509userproxy = true
x509userproxy    = /afs/cern.ch/user/p/pleguina/private/x509_proxy

queue 300
