###############################################################################
# production_manifest_v2.sub -- Full-scale OMTF Phase2 production to EOS prodv2
#
# Regenerated from dataset_manifest.json (authoritative) + each dataset's own
# already-vetted per-dataset condor/*.sub (event-count/job-count/JobFlavour taken
# from there, not invented). Scope, per explicit user instruction:
#   - ALL C-family (C1-C30: prompt/disp/mild-disp, noPU + PU200) -- includes
#     C29/C30 (mild-disp pt10to20/pt20to50 overlap PU200, added to close a
#     coverage gap alongside existing C25-C28 mild-disp pt2to5/pt5to10)
#   - ALL G-family (G5,G6,G8,G10 pos/neg,G13 pos/neg,G14 pos/neg,G15 pos/neg,
#     G16 pos/neg,G17,G18 pos/neg) -- includes transition-region (G13/G14,
#     1.2<|eta|<1.6), low-eta barrel-overlap transition-region (G18,
#     0.70<|eta|<0.90, added to close a coverage gap below the OMTF overlap
#     acceptance floor), and endcap-region (G15/G16, 1.8<|eta|<3.0) eta
#     guard-band coverage
#   - B4 ONLY from the B-family (B1-B3 are historical_excluded, NOT included)
#   - NO S-family (S1-S5 are historical_excluded, NOT included)
#
# DAS-family (dy_prompt, single_muon_flatpt, displaced_lowpt, displaced_midpt,
# llp_addon, qcd_heavy_flavour_PU200) is handled separately in
# condor/production_manifest_v2_das.sub (uses run_das_job_prodv2.sh, not this
# executable). llp_addon and qcd_heavy_flavour_PU200 are currently EXCLUDED
# from that file pending real fixes (see its header for details).
#
# Totals: 47 datasets, 14500 jobs, 7250000 events (500 events/job).
#
# CMSSW_14_2_0_pre2 (Phase2C17I13M9, Extended2026D110, 140X_mcRun4_realistic_v4)
#
# PREREQUISITES:
#   1. Valid grid proxy (8+ hours validity):
#      voms-proxy-init --voms cms --valid 192:00 -out private/x509_proxy
#   2. CMSSW built in $HOME:
#      cd $HOME/CMSSW_14_2_0_pre2/src && scram b -j8 L1Trigger/L1TMuonOverlapPhase1 L1Trigger/L1TMuonOverlapPhase2
#   3. EOS quota available:
#      eos quota | head
#
# SUBMIT (NOT executed by this task -- requires explicit human go-ahead):
#   condor_submit condor/production_manifest_v2.sub
#
# MONITOR:
#   condor_q -format "%s " ClusterId -format "%s " Args | grep prodv2
#   eos ls /eos/user/p/pleguina/omtf_hecin_datasets/prodv2/
#
###############################################################################

universe        = vanilla
executable      = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/run_job_prodv2.sh

should_transfer_files = NO

request_cpus    = 1
request_memory  = 4000
request_disk    = 5000000

+AccountingGroup = "group_u_CMS.u_zh.users"
use_x509userproxy = true
x509userproxy    = /afs/cern.ch/user/p/pleguina/private/x509_proxy

###############################################################################
# C-Campaign: controlled prompt/displaced/mild-displaced pT-binned grid (noPU + PU200) (30 datasets)
###############################################################################
+JobFlavour     = "workday"
arguments       = $(Dataset) $(ProcId) 0 $(NEvents)
output          = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/prodv2_$(Dataset)_$(ProcId).out
error           = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/prodv2_$(Dataset)_$(ProcId).err
log             = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/production_manifest_v2.log
queue Dataset, NEvents from (
    C1_prompt_pt2to5_overlap 500
