###############################################################################
# G7.sub — HTCondor submit for GMT-overlap dataset G7
# G7_hardNegLowEtaMuon: barrel muon |eta|<0.75, no PU (hard negative)
# Target: 150,000 events, 500 events/job, 300 jobs
###############################################################################
universe        = vanilla
executable      = /afs/cern.ch/user/p/pleguina/omtf_hecin_dataset_production/condor/run_job.sh
arguments       = G7 $(ProcId) 0 500

output          = /afs/cern.ch/user/p/pleguina/omtf_hecin_dataset_production/condor/logs/G7_$(ProcId).out
error           = /afs/cern.ch/user/p/pleguina/omtf_hecin_dataset_production/condor/logs/G7_$(ProcId).err
log             = /afs/cern.ch/user/p/pleguina/omtf_hecin_dataset_production/condor/logs/G7.log

should_transfer_files = NO

request_cpus    = 1
request_memory  = 4000
request_disk    = 5000000

+JobFlavour     = "workday"

+AccountingGroup = "group_u_CMS.u_zh.users"
use_x509userproxy = true
x509userproxy    = /afs/cern.ch/user/p/pleguina/private/x509_proxy

queue 300
