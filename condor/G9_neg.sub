###############################################################################
# G9_neg.sub - HTCondor submit for GMT-overlap dataset G9_neg
# single high-eta muon, no PU, negative eta [-1.80,-1.30] (endcap hard negative)
# Target: 75,000 events, 500 events/job, 150 jobs
###############################################################################
universe        = vanilla
executable      = /afs/cern.ch/user/p/pleguina/omtf_hecin_dataset_production/condor/run_job.sh
arguments       = G9_neg $(ProcId) 0 500

output          = /afs/cern.ch/user/p/pleguina/omtf_hecin_dataset_production/condor/logs/G9_neg_$(ProcId).out
error           = /afs/cern.ch/user/p/pleguina/omtf_hecin_dataset_production/condor/logs/G9_neg_$(ProcId).err
log             = /afs/cern.ch/user/p/pleguina/omtf_hecin_dataset_production/condor/logs/G9_neg.log

should_transfer_files = NO

request_cpus    = 1
request_memory  = 4000
request_disk    = 5000000

+JobFlavour     = "workday"

+AccountingGroup = "group_u_CMS.u_zh.users"
use_x509userproxy = true
x509userproxy    = /afs/cern.ch/user/p/pleguina/private/x509_proxy

queue 150
