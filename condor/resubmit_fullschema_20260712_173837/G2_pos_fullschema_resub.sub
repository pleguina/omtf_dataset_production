# G2_pos.sub — HTCondor submit for GMT-overlap dataset G2_pos
# single prompt muon, OMTF overlap, PU200, positive eta [0.82,1.24]
# Target: 150000 events, 500 events/job, 300 jobs
###############################################################################
universe        = vanilla
executable      = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/run_job.sh
arguments       = G2_pos $(ProcId) 0 500

output          = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/G2_pos_$(ProcId).out
error           = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/G2_pos_$(ProcId).err
log             = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/G2_pos.log

should_transfer_files = NO

request_cpus    = 1
request_memory  = 4000
request_disk    = 5000000

+JobFlavour     = "workday"

+AccountingGroup = "group_u_CMS.u_zh.users"
