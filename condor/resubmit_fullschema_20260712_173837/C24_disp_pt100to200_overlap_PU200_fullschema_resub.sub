###############################################################################
# C24_disp_pt100to200_overlap_PU200.sub — HTCondor submit for controlled overlap study dataset C24_disp_pt100to200_overlap_PU200
# Displaced pT 100-200 GeV overlap PU200 — WP5 displaced recovery
# Target: 75000 events, 500 events/job, 150 jobs
###############################################################################
universe        = vanilla
executable      = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/run_job.sh
arguments       = C24_disp_pt100to200_overlap_PU200 $(ProcId) 0 500

output          = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/C24_disp_pt100to200_overlap_PU200_$(ProcId).out
error           = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/C24_disp_pt100to200_overlap_PU200_$(ProcId).err
log             = /afs/cern.ch/user/p/pleguina/omtf_dataset_production/condor/logs/C24_disp_pt100to200_overlap_PU200.log

should_transfer_files = NO

request_cpus    = 1
request_memory  = 4000
request_disk    = 5000000

+JobFlavour     = "workday"

+AccountingGroup = "group_u_CMS.u_zh.users"
use_x509userproxy = true
x509userproxy    = /afs/cern.ch/user/p/pleguina/private/x509_proxy

queue ProcId from (
1
3
7
19
57
64
67
93
102
119
140
141
143
)
